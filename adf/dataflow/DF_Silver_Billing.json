{
	"name": "DF_Silver_Billing",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Bronze_Billing",
						"type": "DatasetReference"
					},
					"name": "FacturacionBronze"
				},
				{
					"dataset": {
						"referenceName": "DS_Silver_Admissions",
						"type": "DatasetReference"
					},
					"name": "AdmisionesSilver"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Silver_Billing",
						"type": "DatasetReference"
					},
					"name": "FacturacionSilver"
				}
			],
			"transformations": [
				{
					"name": "LimpiarFacturacion"
				},
				{
					"name": "FacturasValidas"
				},
				{
					"name": "Existe"
				}
			],
			"scriptLines": [
				"source(output(",
				"          billing_id as string,",
				"          admission_id as string,",
				"          charge_type as string,",
				"          amount as string,",
				"          payment_status as string,",
				"          payment_date as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> FacturacionBronze",
				"source(output(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> AdmisionesSilver",
				"FacturacionBronze derive(billing_id = toInteger(trim(billing_id)),",
				"          admission_id = toInteger(trim(admission_id)),",
				"          charge_type = trim(charge_type),",
				"          amount = toDecimal(trim(replace(replace(replace(amount, 'USD', ''), '$', ''), ',', '')), 12, 2),",
				"          payment_status = lower(trim(payment_status)),",
				"          payment_date = case(\r",
				"    isDate(trim(payment_date), 'yyyy-MM-dd'), toDate(trim(payment_date), 'yyyy-MM-dd'),\r",
				"    isDate(trim(payment_date), 'MM/dd/yyyy'), toDate(trim(payment_date), 'MM/dd/yyyy'),\r",
				"    isDate(trim(payment_date), 'dd-MMM-yyyy'), toDate(trim(payment_date), 'dd-MMM-yyyy'),\r",
				"    isDate(trim(payment_date), 'MMMM dd, yyyy'), toDate(trim(payment_date), 'MMMM dd, yyyy'),\r",
				"    toDate(null())\r",
				")) ~> LimpiarFacturacion",
				"LimpiarFacturacion filter(!isNull(billing_id)\r",
				"&& !isNull(admission_id)\r",
				"&& !isNull(amount)\r",
				"&& !isNull(charge_type)\r",
				"&& length(charge_type) > 0\r",
				"&& !isNull(payment_status)\r",
				"&& length(payment_status) > 0) ~> FacturasValidas",
				"FacturasValidas, AdmisionesSilver exists(LimpiarFacturacion@admission_id == AdmisionesSilver@admission_id,",
				"     negate:false,",
				"     broadcast: 'auto')~> Existe",
				"Existe sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          billing_id as integer,",
				"          admission_id as integer,",
				"          charge_type as string,",
				"          amount as decimal(12,2),",
				"          payment_status as string,",
				"          payment_date as date",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> FacturacionSilver"
			]
		}
	}
}