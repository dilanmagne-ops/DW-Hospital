{
	"name": "DF_Gold_Fact_Admisiones",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Silver_Admissions",
						"type": "DatasetReference"
					},
					"name": "AdmisionesSilver"
				},
				{
					"dataset": {
						"referenceName": "DS_Gold_Dim_Paciente",
						"type": "DatasetReference"
					},
					"name": "PacientesGold"
				},
				{
					"dataset": {
						"referenceName": "DS_Gold_Dim_Departamento",
						"type": "DatasetReference"
					},
					"name": "DepartamentosGold"
				},
				{
					"dataset": {
						"referenceName": "DS_Gold_Dim_Diagnostico",
						"type": "DatasetReference"
					},
					"name": "DiagnosticosGold"
				},
				{
					"dataset": {
						"referenceName": "DS_Gold_Dim_Fecha",
						"type": "DatasetReference"
					},
					"name": "FechaIngresoGold"
				},
				{
					"dataset": {
						"referenceName": "DS_Gold_Dim_Fecha",
						"type": "DatasetReference"
					},
					"name": "FechaAltaGold"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Gold_Fact_Admisiones",
						"type": "DatasetReference"
					},
					"name": "AdmisionesGold"
				}
			],
			"transformations": [
				{
					"name": "BuscarPaciente"
				},
				{
					"name": "BuscarDepartamento"
				},
				{
					"name": "BuscarDiagnostico"
				},
				{
					"name": "BuscarFechaIngreso"
				},
				{
					"name": "BuscarFechaAlta"
				}
			],
			"scriptLines": [
				"source(output(",
				"          admission_id_bk as integer,",
				"          patient_id as integer,",
				"          nombre_departamento as string,",
				"          fecha_ingreso as date,",
				"          fecha_alta as date,",
				"          medico_id as integer,",
				"          dias_estancia as integer,",
				"          conteo_admisiones as integer,",
				"          codigo_icd as string,",
				"          descripcion_patologia as string,",
				"          nivel_severidad as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT\\n    a.admission_id AS admission_id_bk,\\n    a.patient_id,\\n    TRIM(a.department) AS nombre_departamento,\\n    a.admission_date AS fecha_ingreso,\\n    a.discharge_date AS fecha_alta,\\n    a.attending_doctor_id AS medico_id,\\n    DATEDIFF(day, a.admission_date, a.discharge_date) AS dias_estancia,\\n    1 AS conteo_admisiones,\\n    CASE WHEN d.diagnosis_id IS NULL THEN \\'SIN_REGISTRO\\'\\n         ELSE TRIM(d.icd_code) END AS codigo_icd,\\n    CASE WHEN d.diagnosis_id IS NULL THEN N\\'Sin diagnóstico registrado\\'\\n         ELSE NULLIF(TRIM(d.diagnosis_description), \\'\\') END AS descripcion_patologia,\\n    COALESCE(NULLIF(TRIM(d.severity), \\'\\'), \\'No informado\\') AS nivel_severidad\\nFROM silver.admissions AS a\\nOUTER APPLY (\\n    SELECT TOP (1)\\n        dx.diagnosis_id,\\n        dx.icd_code,\\n        dx.diagnosis_description,\\n        dx.severity\\n    FROM silver.diagnoses AS dx\\n    WHERE dx.admission_id = a.admission_id\\n    ORDER BY dx.diagnosis_id\\n) AS d',",
				"     format: 'query') ~> AdmisionesSilver",
				"source(output(",
				"          paciente_key as integer,",
				"          patient_id_bk as integer,",
				"          nombre_completo as string,",
				"          genero as string,",
				"          fecha_nacimiento as date,",
				"          rango_etario as string,",
				"          correo_electronico as string,",
				"          direccion as string,",
				"          proveedor_seguro as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> PacientesGold",
				"source(output(",
				"          departamento_key as integer,",
				"          nombre_departamento as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DepartamentosGold",
				"source(output(",
				"          diagnostico_key as integer,",
				"          codigo_icd as string,",
				"          descripcion_patologia as string,",
				"          nivel_severidad as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DiagnosticosGold",
				"source(output(",
				"          fecha_key as integer,",
				"          fecha_completa as date,",
				"          anio as integer,",
				"          trimestre as integer,",
				"          trimestre_nombre as string,",
				"          mes as integer,",
				"          mes_nombre as string,",
				"          mes_corto as string,",
				"          semana_anio as integer,",
				"          dia_mes as integer,",
				"          dia_semana as integer,",
				"          dia_nombre as string,",
				"          es_fin_de_semana as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> FechaIngresoGold",
				"source(output(",
				"          fecha_key as integer,",
				"          fecha_completa as date,",
				"          anio as integer,",
				"          trimestre as integer,",
				"          trimestre_nombre as string,",
				"          mes as integer,",
				"          mes_nombre as string,",
				"          mes_corto as string,",
				"          semana_anio as integer,",
				"          dia_mes as integer,",
				"          dia_semana as integer,",
				"          dia_nombre as string,",
				"          es_fin_de_semana as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> FechaAltaGold",
				"AdmisionesSilver, PacientesGold lookup(patient_id == patient_id_bk,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> BuscarPaciente",
				"BuscarPaciente, DepartamentosGold lookup(AdmisionesSilver@nombre_departamento == DepartamentosGold@nombre_departamento,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> BuscarDepartamento",
				"BuscarDepartamento, DiagnosticosGold lookup(AdmisionesSilver@codigo_icd == DiagnosticosGold@codigo_icd",
				"     && AdmisionesSilver@nivel_severidad == DiagnosticosGold@nivel_severidad",
				"     && coalesce(AdmisionesSilver@descripcion_patologia, '') == coalesce(DiagnosticosGold@descripcion_patologia, ''),",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> BuscarDiagnostico",
				"BuscarDiagnostico, FechaIngresoGold lookup(fecha_ingreso == fecha_completa,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> BuscarFechaIngreso",
				"BuscarFechaIngreso, FechaAltaGold lookup(fecha_alta == FechaAltaGold@fecha_completa,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> BuscarFechaAlta",
				"BuscarFechaAlta sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          admision_key as long,",
				"          admission_id_bk as integer,",
				"          paciente_key as integer,",
				"          departamento_key as integer,",
				"          diagnostico_key as integer,",
				"          fecha_ingreso_key as integer,",
				"          fecha_alta_key as integer,",
				"          medico_id as integer,",
				"          dias_estancia as integer,",
				"          conteo_admisiones as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          each(match(/* All input columns */ true()),",
				"               /* Input name */ $$ = $$),",
				"          admission_id_bk,",
				"          paciente_key,",
				"          paciente_key = departamento_key,",
				"          departamento_key = admission_id_bk,",
				"          diagnostico_key,",
				"          fecha_ingreso_key = FechaIngresoGold@fecha_key,",
				"          fecha_alta_key = FechaAltaGold@fecha_key,",
				"          medico_id,",
				"          dias_estancia,",
				"          conteo_admisiones",
				"     )) ~> AdmisionesGold"
			]
		}
	}
}