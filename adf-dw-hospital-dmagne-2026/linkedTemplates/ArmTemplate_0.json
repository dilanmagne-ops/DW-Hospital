		{
			"name": "[concat(parameters('factoryName'), '/DF_Gold_Dim_Fecha')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Admissions",
								"type": "DatasetReference"
							},
							"name": "FechasSilver"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Gold_Dim_Fecha",
								"type": "DatasetReference"
							},
							"name": "FechaGold"
						}
					],
					"transformations": [
						{
							"name": "AtributosFecha"
						}
					],
					"scriptLines": [
						"source(output(",
						"          fecha_completa as date",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT admission_date AS fecha_completa\\nFROM silver.admissions\\nWHERE admission_date IS NOT NULL\\nUNION\\nSELECT discharge_date AS fecha_completa\\nFROM silver.admissions\\nWHERE discharge_date IS NOT NULL\\nUNION\\nSELECT payment_date AS fecha_completa\\nFROM silver.billing\\nWHERE payment_date IS NOT NULL',",
						"     format: 'query') ~> FechasSilver",
						"FechasSilver derive(fecha_key = year(fecha_completa) * 10000 + month(fecha_completa) * 100 + dayOfMonth(fecha_completa),",
						"          anio = year(fecha_completa),",
						"          trimestre = toInteger(ceil(month(fecha_completa) / 3.0)),",
						"          trimestre_nombre = concat('T', toString(toInteger(ceil(month(fecha_completa) / 3.0)))),",
						"          mes = month(fecha_completa),",
						"          mes_nombre = at(['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'], month(fecha_completa)),",
						"          mes_corto = at(['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'], month(fecha_completa)),",
						"          semana_anio = weekOfYear(fecha_completa),",
						"          dia_mes = dayOfMonth(fecha_completa),",
						"          dia_semana = iif(dayOfWeek(fecha_completa) == 1, 7, dayOfWeek(fecha_completa) - 1),",
						"          dia_nombre = at(['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'], dayOfWeek(fecha_completa)),",
						"          es_fin_de_semana = dayOfWeek(fecha_completa) == 1 || dayOfWeek(fecha_completa) == 7) ~> AtributosFecha",
						"AtributosFecha sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          fecha_key as integer,",
						"          fecha_completa as date,",
						"          anio as integer,",
						"          trimestre as integer,",
						"          trimestre_nombre as string,",
						"          mes as integer,",
						"          mes_nombre as string,",
						"          mes_corto as string,",
						"          semana_anio as integer,",
						"          dia_mes as integer,",
						"          dia_semana as integer,",
						"          dia_nombre as string,",
						"          es_fin_de_semana as boolean",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> FechaGold"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_Silver_Admissions')]",
				"[concat(variables('factoryId'), '/datasets/DS_Gold_Dim_Fecha')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_Gold_Dim_Paciente')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Patients",
								"type": "DatasetReference"
							},
							"name": "PacientesSilver"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Gold_Dim_Paciente",
								"type": "DatasetReference"
							},
							"name": "PacienteGold"
						}
					],
					"transformations": [],
					"scriptLines": [
						"source(output(",
						"          patient_id_bk as integer,",
						"          nombre_completo as string,",
						"          genero as string,",
						"          fecha_nacimiento as date,",
						"          rango_etario as string,",
						"          correo_electronico as string,",
						"          direccion as string,",
						"          proveedor_seguro as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT\\n    p.patient_id AS patient_id_bk,\\n    p.full_name AS nombre_completo,\\n    CASE UPPER(TRIM(p.gender))\\n        WHEN \\'F\\' THEN \\'Femenino\\'\\n        WHEN \\'M\\' THEN \\'Masculino\\'\\n        ELSE \\'Otro\\'\\n    END AS genero,\\n    p.date_of_birth AS fecha_nacimiento,\\n    CASE\\n        WHEN p.date_of_birth IS NULL OR p.date_of_birth > corte.hoy THEN NULL\\n        WHEN edad.anios <= 18 THEN \\'0-18\\'\\n        WHEN edad.anios <= 35 THEN \\'19-35\\'\\n        WHEN edad.anios <= 60 THEN \\'36-60\\'\\n        ELSE \\'60+\\'\\n    END AS rango_etario,\\n    p.email AS correo_electronico,\\n    p.address AS direccion,\\nCOALESCE(NULLIF(TRIM(p.insurance_provider), \\'\\'), N\\'No informado\\') AS proveedor_seguro\\nFROM silver.patients AS p\\nCROSS APPLY (VALUES (CAST(SYSUTCDATETIME() AS date))) AS corte(hoy)\\nCROSS APPLY (VALUES (DATEDIFF(year, p.date_of_birth, corte.hoy))) AS dif(anios)\\nCROSS APPLY (VALUES (\\n    dif.anios - CASE\\n        WHEN DATEADD(year, dif.anios, p.date_of_birth) > corte.hoy THEN 1\\n        ELSE 0\\n    END\\n)) AS edad(anios)',",
						"     format: 'query') ~> PacientesSilver",
						"PacientesSilver sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          paciente_key as integer,",
						"          patient_id_bk as integer,",
						"          nombre_completo as string,",
						"          genero as string,",
						"          fecha_nacimiento as date,",
						"          rango_etario as string,",
						"          correo_electronico as string,",
						"          direccion as string,",
						"          proveedor_seguro as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> PacienteGold"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_Silver_Patients')]",
				"[concat(variables('factoryId'), '/datasets/DS_Gold_Dim_Paciente')]"
			]
		}
	]
