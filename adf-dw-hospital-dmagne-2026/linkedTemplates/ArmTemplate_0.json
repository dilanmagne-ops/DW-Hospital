		{
			"name": "[concat(parameters('factoryName'), '/DF_Silver_Patients')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Bronze_Patients",
								"type": "DatasetReference"
							},
							"name": "PacientesBronze"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Patients",
								"type": "DatasetReference"
							},
							"name": "PacientesSilver"
						}
					],
					"transformations": [
						{
							"name": "LimpiarPacientes"
						}
					],
					"scriptLines": [
						"source(output(",
						"          patient_id as string,",
						"          full_name as string,",
						"          gender as string,",
						"          date_of_birth as string,",
						"          phone as string,",
						"          email as string,",
						"          address as string,",
						"          insurance_provider as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> PacientesBronze",
						"PacientesBronze derive(gender = case(     in(['f', 'female'], lower(trim(gender))), 'F',     in(['m', 'male'], lower(trim(gender))), 'M',     toString(null()) ),",
						"          full_name = trim(full_name),",
						"          patient_id = toInteger(trim(patient_id)),",
						"          date_of_birth = case(     isNull(date_of_birth), toDate(null()),     length(trim(date_of_birth)) == 8, toDate(null()),     isDate(trim(date_of_birth), 'yyyy-MM-dd'), toDate(trim(date_of_birth), 'yyyy-MM-dd'),     isDate(trim(date_of_birth), 'MM/dd/yyyy'), toDate(trim(date_of_birth), 'MM/dd/yyyy'),     isDate(trim(date_of_birth), 'dd-MMM-yyyy'), toDate(trim(date_of_birth), 'dd-MMM-yyyy'),     isDate(trim(date_of_birth), 'MMMM dd, yyyy'), toDate(trim(date_of_birth), 'MMMM dd, yyyy'),     toDate(null()) )) ~> LimpiarPacientes",
						"LimpiarPacientes sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          patient_id as integer,",
						"          full_name as string,",
						"          gender as string,",
						"          date_of_birth as date,",
						"          phone as string,",
						"          email as string,",
						"          address as string,",
						"          insurance_provider as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> PacientesSilver"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_Bronze_Patients')]",
				"[concat(variables('factoryId'), '/datasets/DS_Silver_Patients')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_Silver_Admissions')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Bronze_Admissions",
								"type": "DatasetReference"
							},
							"name": "AdmisionesBronze"
						},
						{
							"dataset": {
								"referenceName": "DS_Silver_Patients",
								"type": "DatasetReference"
							},
							"name": "PacientesReferencia"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Admissions",
								"type": "DatasetReference"
							},
							"name": "AdmisionesSilver"
						}
					],
					"transformations": [
						{
							"name": "LimpiarAdmisiones"
						},
						{
							"name": "AdmisionesValidas"
						},
						{
							"name": "AdmisionesConPaciente"
						}
					],
					"scriptLines": [
						"source(output(",
						"          admission_id as string,",
						"          patient_id as string,",
						"          admission_date as string,",
						"          discharge_date as string,",
						"          department as string,",
						"          attending_doctor_id as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> AdmisionesBronze",
						"source(output(",
						"          patient_id as integer,",
						"          full_name as string,",
						"          gender as string,",
						"          date_of_birth as date,",
						"          phone as string,",
						"          email as string,",
						"          address as string,",
						"          insurance_provider as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> PacientesReferencia",
						"AdmisionesBronze derive(admission_id = toInteger(trim(admission_id)),",
						"          patient_id = toInteger(trim(patient_id)),",
						"          attending_doctor_id = toInteger(trim(attending_doctor_id)),",
						"          department = trim(department),",
						"          admission_date = case(\r",
						"    isNull(admission_date) || trim(admission_date) == '', toDate(null()),\r",
						"    length(trim(admission_date)) == 8 &&\r",
						"        in(['23', '24', '25', '26'], right(trim(admission_date), 2)),\r",
						"        toDate(\r",
						"            concat(left(trim(admission_date), 6), '20', right(trim(admission_date), 2)),\r",
						"            'MM-dd-yyyy'\r",
						"        ),\r",
						"    isDate(trim(admission_date), 'yyyy-MM-dd'), toDate(trim(admission_date), 'yyyy-MM-dd'),\r",
						"    isDate(trim(admission_date), 'MM/dd/yyyy'), toDate(trim(admission_date), 'MM/dd/yyyy'),\r",
						"    isDate(trim(admission_date), 'dd-MMM-yyyy'), toDate(trim(admission_date), 'dd-MMM-yyyy'),\r",
						"    isDate(trim(admission_date), 'MMMM dd, yyyy'), toDate(trim(admission_date), 'MMMM dd, yyyy'),\r",
						"    toDate(null())\r",
						"),",
						"          discharge_date = case(\r",
						"    isNull(discharge_date) || trim(discharge_date) == '', toDate(null()),\r",
						"    length(trim(discharge_date)) == 8 &&\r",
						"        in(['23', '24', '25', '26'], right(trim(discharge_date), 2)),\r",
						"        toDate(\r",
						"            concat(left(trim(discharge_date), 6), '20', right(trim(discharge_date), 2)),\r",
						"            'MM-dd-yyyy'\r",
						"        ),\r",
						"    isDate(trim(discharge_date), 'yyyy-MM-dd'), toDate(trim(discharge_date), 'yyyy-MM-dd'),\r",
						"    isDate(trim(discharge_date), 'MM/dd/yyyy'), toDate(trim(discharge_date), 'MM/dd/yyyy'),\r",
						"    isDate(trim(discharge_date), 'dd-MMM-yyyy'), toDate(trim(discharge_date), 'dd-MMM-yyyy'),\r",
						"    isDate(trim(discharge_date), 'MMMM dd, yyyy'), toDate(trim(discharge_date), 'MMMM dd, yyyy'),\r",
						"    toDate(null())\r",
						")) ~> LimpiarAdmisiones",
						"LimpiarAdmisiones filter(!isNull(admission_id) &&",
						"!isNull(patient_id) &&",
						"!isNull(attending_doctor_id) &&",
						"!isNull(admission_date) &&",
						"!isNull(department) &&",
						"length(trim(department)) > 0) ~> AdmisionesValidas",
						"AdmisionesValidas, PacientesReferencia exists(LimpiarAdmisiones@patient_id == PacientesReferencia@patient_id,",
						"     negate:false,",
						"     broadcast: 'auto')~> AdmisionesConPaciente",
						"AdmisionesConPaciente sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          admission_id as integer,",
						"          patient_id as integer,",
						"          admission_date as date,",
						"          discharge_date as date,",
						"          department as string,",
						"          attending_doctor_id as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> AdmisionesSilver"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_Bronze_Admissions')]",
				"[concat(variables('factoryId'), '/datasets/DS_Silver_Patients')]",
				"[concat(variables('factoryId'), '/datasets/DS_Silver_Admissions')]"
			]
		},
