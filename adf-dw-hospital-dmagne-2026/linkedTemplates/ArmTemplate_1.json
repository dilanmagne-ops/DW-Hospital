{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nombre de instancia de Data Factory",
			"defaultValue": "adf-dw-hospital-dmagne-2026"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/DF_Gold_Fact_Admisiones')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Admissions",
								"type": "DatasetReference"
							},
							"name": "AdmisionesSilver"
						},
						{
							"dataset": {
								"referenceName": "DS_Gold_Dim_Paciente",
								"type": "DatasetReference"
							},
							"name": "PacientesGold"
						},
						{
							"dataset": {
								"referenceName": "DS_Gold_Dim_Departamento",
								"type": "DatasetReference"
							},
							"name": "DepartamentosGold"
						},
						{
							"dataset": {
								"referenceName": "DS_Gold_Dim_Diagnostico",
								"type": "DatasetReference"
							},
							"name": "DiagnosticosGold"
						},
						{
							"dataset": {
								"referenceName": "DS_Gold_Dim_Fecha",
								"type": "DatasetReference"
							},
							"name": "FechaIngresoGold"
						},
						{
							"dataset": {
								"referenceName": "DS_Gold_Dim_Fecha",
								"type": "DatasetReference"
							},
							"name": "FechaAltaGold"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Gold_Fact_Admisiones",
								"type": "DatasetReference"
							},
							"name": "AdmisionesGold"
						}
					],
					"transformations": [
						{
							"name": "BuscarPaciente"
						},
						{
							"name": "BuscarDepartamento"
						},
						{
							"name": "BuscarDiagnostico"
						},
						{
							"name": "BuscarFechaIngreso"
						},
						{
							"name": "BuscarFechaAlta"
						}
					],
					"scriptLines": [
						"source(output(",
						"          admission_id_bk as integer,",
						"          patient_id as integer,",
						"          nombre_departamento as string,",
						"          fecha_ingreso as date,",
						"          fecha_alta as date,",
						"          medico_id as integer,",
						"          dias_estancia as integer,",
						"          conteo_admisiones as integer,",
						"          codigo_icd as string,",
						"          descripcion_patologia as string,",
						"          nivel_severidad as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT\\n    a.admission_id AS admission_id_bk,\\n    a.patient_id,\\n    TRIM(a.department) AS nombre_departamento,\\n    a.admission_date AS fecha_ingreso,\\n    a.discharge_date AS fecha_alta,\\n    a.attending_doctor_id AS medico_id,\\n    DATEDIFF(day, a.admission_date, a.discharge_date) AS dias_estancia,\\n    1 AS conteo_admisiones,\\n    CASE WHEN d.diagnosis_id IS NULL THEN \\'SIN_REGISTRO\\'\\n         ELSE TRIM(d.icd_code) END AS codigo_icd,\\n    CASE WHEN d.diagnosis_id IS NULL THEN N\\'Sin diagnóstico registrado\\'\\n         ELSE NULLIF(TRIM(d.diagnosis_description), \\'\\') END AS descripcion_patologia,\\n    COALESCE(NULLIF(TRIM(d.severity), \\'\\'), \\'No informado\\') AS nivel_severidad\\nFROM silver.admissions AS a\\nOUTER APPLY (\\n    SELECT TOP (1)\\n        dx.diagnosis_id,\\n        dx.icd_code,\\n        dx.diagnosis_description,\\n        dx.severity\\n    FROM silver.diagnoses AS dx\\n    WHERE dx.admission_id = a.admission_id\\n    ORDER BY dx.diagnosis_id\\n) AS d',",
						"     format: 'query') ~> AdmisionesSilver",
						"source(output(",
						"          paciente_key as integer,",
						"          patient_id_bk as integer,",
						"          nombre_completo as string,",
						"          genero as string,",
						"          fecha_nacimiento as date,",
						"          rango_etario as string,",
						"          correo_electronico as string,",
						"          direccion as string,",
						"          proveedor_seguro as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> PacientesGold",
						"source(output(",
						"          departamento_key as integer,",
						"          nombre_departamento as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> DepartamentosGold",
						"source(output(",
						"          diagnostico_key as integer,",
						"          codigo_icd as string,",
						"          descripcion_patologia as string,",
						"          nivel_severidad as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> DiagnosticosGold",
						"source(output(",
						"          fecha_key as integer,",
						"          fecha_completa as date,",
						"          anio as integer,",
						"          trimestre as integer,",
						"          trimestre_nombre as string,",
						"          mes as integer,",
						"          mes_nombre as string,",
						"          mes_corto as string,",
						"          semana_anio as integer,",
						"          dia_mes as integer,",
						"          dia_semana as integer,",
						"          dia_nombre as string,",
						"          es_fin_de_semana as boolean",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> FechaIngresoGold",
						"source(output(",
						"          fecha_key as integer,",
						"          fecha_completa as date,",
						"          anio as integer,",
						"          trimestre as integer,",
						"          trimestre_nombre as string,",
						"          mes as integer,",
						"          mes_nombre as string,",
						"          mes_corto as string,",
						"          semana_anio as integer,",
						"          dia_mes as integer,",
						"          dia_semana as integer,",
						"          dia_nombre as string,",
						"          es_fin_de_semana as boolean",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> FechaAltaGold",
						"AdmisionesSilver, PacientesGold lookup(patient_id == patient_id_bk,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> BuscarPaciente",
						"BuscarPaciente, DepartamentosGold lookup(AdmisionesSilver@nombre_departamento == DepartamentosGold@nombre_departamento,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> BuscarDepartamento",
						"BuscarDepartamento, DiagnosticosGold lookup(AdmisionesSilver@codigo_icd == DiagnosticosGold@codigo_icd",
						"     && AdmisionesSilver@nivel_severidad == DiagnosticosGold@nivel_severidad",
						"     && coalesce(AdmisionesSilver@descripcion_patologia, '') == coalesce(DiagnosticosGold@descripcion_patologia, ''),",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> BuscarDiagnostico",
						"BuscarDiagnostico, FechaIngresoGold lookup(fecha_ingreso == fecha_completa,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> BuscarFechaIngreso",
						"BuscarFechaIngreso, FechaAltaGold lookup(fecha_alta == FechaAltaGold@fecha_completa,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> BuscarFechaAlta",
						"BuscarFechaAlta sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          admision_key as long,",
						"          admission_id_bk as integer,",
						"          paciente_key as integer,",
						"          departamento_key as integer,",
						"          diagnostico_key as integer,",
						"          fecha_ingreso_key as integer,",
						"          fecha_alta_key as integer,",
						"          medico_id as integer,",
						"          dias_estancia as integer,",
						"          conteo_admisiones as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          admission_id_bk,",
						"          paciente_key,",
						"          departamento_key,",
						"          diagnostico_key,",
						"          fecha_ingreso_key = FechaIngresoGold@fecha_key,",
						"          fecha_alta_key = FechaAltaGold@fecha_key,",
						"          medico_id,",
						"          dias_estancia,",
						"          conteo_admisiones",
						"     )) ~> AdmisionesGold"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_Silver_Admissions')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Bronze_Admissions",
								"type": "DatasetReference"
							},
							"name": "AdmisionesBronze"
						},
						{
							"dataset": {
								"referenceName": "DS_Silver_Patients",
								"type": "DatasetReference"
							},
							"name": "PacientesReferencia"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Admissions",
								"type": "DatasetReference"
							},
							"name": "AdmisionesSilver"
						}
					],
					"transformations": [
						{
							"name": "LimpiarAdmisiones"
						},
						{
							"name": "AdmisionesValidas"
						},
						{
							"name": "AdmisionesConPaciente"
						}
					],
					"scriptLines": [
						"source(output(",
						"          admission_id as string,",
						"          patient_id as string,",
						"          admission_date as string,",
						"          discharge_date as string,",
						"          department as string,",
						"          attending_doctor_id as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> AdmisionesBronze",
						"source(output(",
						"          patient_id as integer,",
						"          full_name as string,",
						"          gender as string,",
						"          date_of_birth as date,",
						"          phone as string,",
						"          email as string,",
						"          address as string,",
						"          insurance_provider as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> PacientesReferencia",
						"AdmisionesBronze derive(admission_id = toInteger(trim(admission_id)),",
						"          patient_id = toInteger(trim(patient_id)),",
						"          attending_doctor_id = toInteger(trim(attending_doctor_id)),",
						"          department = trim(department),",
						"          admission_date = case(\r",
						"    isNull(admission_date) || trim(admission_date) == '', toDate(null()),\r",
						"    length(trim(admission_date)) == 8 &&\r",
						"        in(['23', '24', '25', '26'], right(trim(admission_date), 2)),\r",
						"        toDate(\r",
						"            concat(left(trim(admission_date), 6), '20', right(trim(admission_date), 2)),\r",
						"            'MM-dd-yyyy'\r",
						"        ),\r",
						"    isDate(trim(admission_date), 'yyyy-MM-dd'), toDate(trim(admission_date), 'yyyy-MM-dd'),\r",
						"    isDate(trim(admission_date), 'MM/dd/yyyy'), toDate(trim(admission_date), 'MM/dd/yyyy'),\r",
						"    isDate(trim(admission_date), 'dd-MMM-yyyy'), toDate(trim(admission_date), 'dd-MMM-yyyy'),\r",
						"    isDate(trim(admission_date), 'MMMM dd, yyyy'), toDate(trim(admission_date), 'MMMM dd, yyyy'),\r",
						"    toDate(null())\r",
						"),",
						"          discharge_date = case(\r",
						"    isNull(discharge_date) || trim(discharge_date) == '', toDate(null()),\r",
						"    length(trim(discharge_date)) == 8 &&\r",
						"        in(['23', '24', '25', '26'], right(trim(discharge_date), 2)),\r",
						"        toDate(\r",
						"            concat(left(trim(discharge_date), 6), '20', right(trim(discharge_date), 2)),\r",
						"            'MM-dd-yyyy'\r",
						"        ),\r",
						"    isDate(trim(discharge_date), 'yyyy-MM-dd'), toDate(trim(discharge_date), 'yyyy-MM-dd'),\r",
						"    isDate(trim(discharge_date), 'MM/dd/yyyy'), toDate(trim(discharge_date), 'MM/dd/yyyy'),\r",
						"    isDate(trim(discharge_date), 'dd-MMM-yyyy'), toDate(trim(discharge_date), 'dd-MMM-yyyy'),\r",
						"    isDate(trim(discharge_date), 'MMMM dd, yyyy'), toDate(trim(discharge_date), 'MMMM dd, yyyy'),\r",
						"    toDate(null())\r",
						")) ~> LimpiarAdmisiones",
						"LimpiarAdmisiones filter(!isNull(admission_id) &&",
						"!isNull(patient_id) &&",
						"!isNull(attending_doctor_id) &&",
						"!isNull(admission_date) &&",
						"!isNull(department) &&",
						"length(trim(department)) > 0) ~> AdmisionesValidas",
						"AdmisionesValidas, PacientesReferencia exists(LimpiarAdmisiones@patient_id == PacientesReferencia@patient_id,",
						"     negate:false,",
						"     broadcast: 'auto')~> AdmisionesConPaciente",
						"AdmisionesConPaciente sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          admission_id as integer,",
						"          patient_id as integer,",
						"          admission_date as date,",
						"          discharge_date as date,",
						"          department as string,",
						"          attending_doctor_id as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> AdmisionesSilver"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_Silver_Billing')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Bronze_Billing",
								"type": "DatasetReference"
							},
							"name": "FacturacionBronze"
						},
						{
							"dataset": {
								"referenceName": "DS_Silver_Admissions",
								"type": "DatasetReference"
							},
							"name": "AdmisionesSilver"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Billing",
								"type": "DatasetReference"
							},
							"name": "FacturacionSilver"
						}
					],
					"transformations": [
						{
							"name": "LimpiarFacturacion"
						},
						{
							"name": "FacturasValidas"
						},
						{
							"name": "Existe"
						}
					],
					"scriptLines": [
						"source(output(",
						"          billing_id as string,",
						"          admission_id as string,",
						"          charge_type as string,",
						"          amount as string,",
						"          payment_status as string,",
						"          payment_date as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> FacturacionBronze",
						"source(output(",
						"          admission_id as integer,",
						"          patient_id as integer,",
						"          admission_date as date,",
						"          discharge_date as date,",
						"          department as string,",
						"          attending_doctor_id as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> AdmisionesSilver",
						"FacturacionBronze derive(billing_id = toInteger(trim(billing_id)),",
						"          admission_id = toInteger(trim(admission_id)),",
						"          charge_type = trim(charge_type),",
						"          amount = toDecimal(trim(replace(replace(replace(amount, 'USD', ''), '$', ''), ',', '')), 12, 2),",
						"          payment_status = lower(trim(payment_status)),",
						"          payment_date = case(\r",
						"    length(trim(payment_date)) == 8 && isDate(trim(payment_date), 'MM-dd-yy'),\r",
						"        toDate(concat('20', right(trim(payment_date), 2), '-', left(trim(payment_date), 2), '-', substring(trim(payment_date), 4, 2)), 'yyyy-MM-dd'),\r",
						"    isDate(trim(payment_date), 'yyyy-MM-dd'), toDate(trim(payment_date), 'yyyy-MM-dd'),\r",
						"    isDate(trim(payment_date), 'MM/dd/yyyy'), toDate(trim(payment_date), 'MM/dd/yyyy'),\r",
						"    isDate(trim(payment_date), 'dd-MMM-yyyy'), toDate(trim(payment_date), 'dd-MMM-yyyy'),\r",
						"    isDate(trim(payment_date), 'MMMM dd, yyyy'), toDate(trim(payment_date), 'MMMM dd, yyyy'),\r",
						"    toDate(null())\r",
						")) ~> LimpiarFacturacion",
						"LimpiarFacturacion filter(!isNull(billing_id)\r",
						"&& !isNull(admission_id)\r",
						"&& !isNull(amount)\r",
						"&& !isNull(charge_type)\r",
						"&& length(charge_type) > 0\r",
						"&& !isNull(payment_status)\r",
						"&& length(payment_status) > 0) ~> FacturasValidas",
						"FacturasValidas, AdmisionesSilver exists(LimpiarFacturacion@admission_id == AdmisionesSilver@admission_id,",
						"     negate:false,",
						"     broadcast: 'auto')~> Existe",
						"Existe sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          billing_id as integer,",
						"          admission_id as integer,",
						"          charge_type as string,",
						"          amount as decimal(12,2),",
						"          payment_status as string,",
						"          payment_date as date",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> FacturacionSilver"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_Silver_Diagnoses')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Bronze_Diagnoses",
								"type": "DatasetReference"
							},
							"name": "DiagnosticosBronze"
						},
						{
							"dataset": {
								"referenceName": "DS_Silver_Admissions",
								"type": "DatasetReference"
							},
							"name": "AdmisionesReferencia"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Diagnoses",
								"type": "DatasetReference"
							},
							"name": "DiagnosticosSilver"
						}
					],
					"transformations": [
						{
							"name": "LimpiarDiagnosticos"
						},
						{
							"name": "DiagnosticosConAdmision"
						}
					],
					"scriptLines": [
						"source(output(",
						"          diagnosis_id as string,",
						"          admission_id as string,",
						"          icd_code as string,",
						"          diagnosis_description as string,",
						"          severity as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> DiagnosticosBronze",
						"source(output(",
						"          admission_id as integer,",
						"          patient_id as integer,",
						"          admission_date as date,",
						"          discharge_date as date,",
						"          department as string,",
						"          attending_doctor_id as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> AdmisionesReferencia",
						"DiagnosticosBronze derive(diagnosis_id = toInteger(trim(diagnosis_id)),",
						"          admission_id = toInteger(trim(admission_id)),",
						"          icd_code = upper(trim(icd_code)),",
						"          diagnosis_description = trim(diagnosis_description),",
						"          severity = iif(isNull(severity) || trim(severity) == '', toString(null()), upper(trim(severity)))) ~> LimpiarDiagnosticos",
						"LimpiarDiagnosticos, AdmisionesReferencia exists(LimpiarDiagnosticos@admission_id == AdmisionesReferencia@admission_id,",
						"     negate:false,",
